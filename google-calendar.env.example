# Copy to google-calendar.env (git-ignored) and run: bash scripts/crm-set-calendar-secrets.sh
#
# A "Web application" OAuth client in the desk-by-kaptured-ai Google Cloud project (same project as Desk's desktop
# client; the Calendar API and the consent screen are already set up there):
#   Google Cloud console → APIs & Services → Credentials → Create credentials → OAuth client ID → Web application
#   Name:                        CapitalxAI CRM calendar
#   Authorised redirect URIs:    https://ktwqkvjuzsunssudqnrt.supabase.co/functions/v1/crm-mcp/calendar/callback
#   (no JavaScript origins needed)
# If the consent screen is in "Testing", every CRM member's Google account must be listed under Test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty: the script generates a random key and writes it back here. Keep the file — losing the key means every
# member has to reconnect their calendars.
CRM_TOKEN_KEY=
