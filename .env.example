# ---------------------------------------------------------------------------
# API Keys (server-side; never commit real values to git)
# ---------------------------------------------------------------------------

# Exa search. Comma-separated for multiple keys (rotation).
# https://dashboard.exa.ai/api-keys
EXA_API_KEYS=

# Google Gemini (default LLM; fallback to Azure on failure).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# RapidAPI. Comma-separated for multiple keys (rotation on 401/403/429).
# e.g. instagram120 API: https://rapidapi.com/instagram120/api/instagram120
RAPIDAPI_KEYS=

# RapidAPI paid key for Twitter API (twitter-api45). Required for investor Twitter icebreaker.
RAPIDAPI_PAID_KEY=

# Azure OpenAI (fallback when Gemini fails or is not configured).
# Key: AZURE_OPENAI_API_KEY or AZURE_API_KEY. Endpoint/deployment optional (have defaults).
AZURE_OPENAI_API_KEY=
# Optional (defaults shown in azureOpenAiHelper.ts):
# AZURE_OPENAI_ENDPOINT=     # or ENDPOINT_URL. Default: https://resourceplan.services.ai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=   # or DEPLOYMENT_NAME. Default: gpt-4o
# AZURE_OPENAI_DEPLOYMENT_NAME_MINI=  # or DEPLOYMENT_NAME_MINI. Default: gpt-4o-mini
# AZURE_OPENAI_API_VERSION=  # Default: 2024-05-01-preview

# Slack notifications (e.g. companymap completion).
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Supabase (auth + server-side DB)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (for API routes / service role):
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# App URL (OAuth and password reset redirects). Default: https://app.capitalxai.com
NEXT_PUBLIC_APP_URL=https://app.capitalxai.com

# ---------------------------------------------------------------------------
# GCP / Vertex AI (optional; used by local fashion-deep-search route)
# If both GCP vars are set Vertex AI is tried first, then Gemini API as fallback.
# If only GEMINI_API_KEY is set, Gemini API is used directly.
# ---------------------------------------------------------------------------
# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_KEY=   # Full JSON string of a service-account key

# ---------------------------------------------------------------------------
# Investor Research
# ---------------------------------------------------------------------------
# Skip domains/URLs that already exist in investors table. Default: true
SKIP_EXISTING_VALUES=true

# Pause Organization flow (skip fetching contacts after Step 3). Default: true
PAUSE_CONTACTS=true

# ---------------------------------------------------------------------------
# Optional (if you use these features)
# ---------------------------------------------------------------------------
# YOUTUBE_API_KEY=
# NEXT_PUBLIC_GITHUB_TOKEN=
# DEEPGRAM_API=
