# ===============================================================================================================
# CapitalxAI — the ONE env file for everything
#   cp .env.example .env.local      (git-ignored; never commit real values)
#
# Sections:
#   1. Next.js app (read by `npm run dev` / Vercel)
#   2. Edge function secrets (pushed to Supabase with scripts/outreach-set-secrets.sh, which only uploads
#      the allowlisted keys from section 2 + GEMINI_API_KEY — nothing else in this file leaves your machine)
#   3. Local tooling / test logins (never deployed anywhere)
# ===============================================================================================================


# ---------------------------------------------------------------------------------------------------------------
# 1. NEXT.JS APP
# ---------------------------------------------------------------------------------------------------------------

# --- Supabase (auth + server-side DB) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only (API routes / service role):
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# App URL (OAuth and password reset redirects). Default: https://app.capitalxai.com
NEXT_PUBLIC_APP_URL=https://app.capitalxai.com

# --- Exa search. Comma-separated for multiple keys (rotation). https://dashboard.exa.ai/api-keys ---
EXA_API_KEYS=

# --- Google Gemini (default LLM; fallback to Azure on failure). Also used by the outreach edge functions. ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- RapidAPI. Comma-separated for multiple keys (rotation on 401/403/429). ---
# e.g. instagram120 API: https://rapidapi.com/instagram120/api/instagram120
RAPIDAPI_KEYS=
# Paid key for Twitter API (twitter-api45). Required for investor Twitter icebreaker.
RAPIDAPI_PAID_KEY=

# --- Azure OpenAI (fallback when Gemini fails or is not configured) ---
# Key: AZURE_OPENAI_API_KEY or AZURE_API_KEY. Endpoint/deployment optional (defaults in azureOpenAiHelper.ts).
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=              # or ENDPOINT_URL. Default: https://resourceplan.services.ai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=       # or DEPLOYMENT_NAME. Default: gpt-4o
# AZURE_OPENAI_DEPLOYMENT_NAME_MINI=  # or DEPLOYMENT_NAME_MINI. Default: gpt-4o-mini
# AZURE_OPENAI_API_VERSION=           # Default: 2024-05-01-preview

# --- GCP / Vertex AI (optional; used by local fashion-deep-search route) ---
# If both GCP vars are set and USE_VERTEX=true, Vertex AI is tried first, then Gemini API as fallback.
# USE_VERTEX=false
# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_KEY=   # Full JSON string of a service-account key

# --- Slack notifications (e.g. companymap completion) ---
SLACK_WEBHOOK_URL=

# --- Investor research ---
# Skip domains/URLs that already exist in investors table. Default: true
SKIP_EXISTING_VALUES=true
# Pause Organization flow (skip fetching contacts after Step 3). Default: true
PAUSE_CONTACTS=true
# PAUSE_FOUNDER_SEARCH=true

# --- Optional (if you use these features) ---
# YOUTUBE_API_KEY=
# NEXT_PUBLIC_GITHUB_TOKEN=
# DEEPGRAM_API=
# GETSALES_KEY=
# CALENDLY_PERSONAL_ACCESS_TOKEN=


# ---------------------------------------------------------------------------------------------------------------
# 2. EDGE FUNCTION SECRETS (outreach / smartlead / crm)
#    Push with: CAPITALXAI_SUPABASE_ACCESS_TOKEN=sbp_... ./scripts/outreach-set-secrets.sh [--dry-run]
#    Empty values are skipped (existing secrets are kept). SUPABASE_URL / SUPABASE_ANON_KEY /
#    SUPABASE_SERVICE_ROLE_KEY are injected by the platform and never pushed.
# ---------------------------------------------------------------------------------------------------------------

# --- Unipile (required for outreach) ---
# DSN host of your Unipile instance, e.g. api1.unipile.com:13111 (with or without https://)
UNIPILE_DSN=
# Unipile API key (X-API-KEY)
UNIPILE_API_KEY=
# Shared secret sent by Unipile in the `Unipile-Auth` header of every webhook; generate: openssl rand -hex 32
# Used by outreach-unipile-webhook to authenticate inbound events and by outreach-unipile-setup when registering.
UNIPILE_WEBHOOK_SECRET=
# White-label host for Hosted Auth Wizard links (CNAME -> account.unipile.com, validated by Unipile support).
# Every connect / re-login link is rewritten to this host so users never see the provider. Ours: auth.growthxai.com
OUTREACH_HOSTED_AUTH_DOMAIN=auth.growthxai.com
# Name shown by the hosted page's browser-extension sign-in as publisher / tab label (<= 60 chars). Default: Outreach
OUTREACH_APP_NAME=GrowthxAI Outreach

# --- Outreach platform internals (required) ---
# Shared secret between pg_cron (Vault secret `outreach_cron_secret`) and the workers (x-cron-secret header).
# MUST match the OUTREACH_CRON_SECRET passed to scripts/outreach-apply-migrations.sh. Generate: openssl rand -hex 32
OUTREACH_CRON_SECRET=
# AES-256-GCM key for LinkedIn cookie secrets: 32 random bytes, base64. Generate: openssl rand -base64 32
# Rotating it makes previously stored cookies undecryptable (see docs/outreach/SETUP.md → runbooks).
OUTREACH_COOKIE_KEY=
# Public origin of the web app (used for redirect / email links). Default https://app.capitalxai.com
OUTREACH_WEB_ORIGIN=https://app.capitalxai.com
# Base URL of the edge functions, with trailing slash. Default: <SUPABASE_URL>/functions/v1/ — leave empty unless proxied.
OUTREACH_FUNCTIONS_BASE_URL=
# Model id for classify / draft / sequence QA (uses GEMINI_API_KEY above). Default gemini-3-flash-preview
OUTREACH_AI_MODEL=gemini-3-flash-preview

# --- Stripe (optional until billing goes live) ---
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<ref>.supabase.co/functions/v1/outreach-stripe-webhook
STRIPE_WEBHOOK_SECRET=
# Recurring per-sender price ids (price_...). planFromSub() also matches on lookup_key / nickname containing
# "agency_plus" / "agency"; the mailbox add-on item is matched on lookup_key / nickname containing "mailbox".
STRIPE_PRICE_TEAM_SENDER=
STRIPE_PRICE_AGENCY_SENDER=
STRIPE_PRICE_AGENCY_PLUS_SENDER=
STRIPE_PRICE_MAILBOX_ADDON=

# --- Email via Resend (optional; without it notifications are logged and skipped) ---
RESEND_API_KEY=
# From header (domain must be verified in Resend). Default: CapitalxAI Outreach <no-reply@capitalxai.com>
OUTREACH_EMAIL_FROM=CapitalxAI Outreach <no-reply@capitalxai.com>

# --- Smartlead MCP ---
SMARTLEAD_API_KEY=
# SMARTLEAD_WEB_ORIGIN=     # falls back to OUTREACH_WEB_ORIGIN

# --- CRM MCP ---
# CRM_WEB_ORIGIN=           # falls back to OUTREACH_WEB_ORIGIN

# --- cleanup-temp-bucket ---
# TEMP_MAX_AGE_HOURS=


# ---------------------------------------------------------------------------------------------------------------
# 3. LOCAL TOOLING / TEST LOGINS (never pushed anywhere)
# ---------------------------------------------------------------------------------------------------------------
# App login used by /client-docs-builder
DOCS_USER=
DOCS_PASS=
# Ad-hoc API tests against outreach-* edge functions
OUTREACH_TEST_EMAIL=
OUTREACH_TEST_PASSWORD=
