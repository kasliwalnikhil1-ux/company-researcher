# ---------------------------------------------------------------------------------------------------------------
# Outreach platform — edge function secrets
# Copy to .env.outreach (git-ignored), fill in, then push with: scripts/outreach-set-secrets.sh
# Empty values are skipped (existing secrets are kept). Never commit .env.outreach.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by the platform — do not set them here.
# ---------------------------------------------------------------------------------------------------------------

# --- Unipile (required) ---
# DSN host of your Unipile instance, e.g. api1.unipile.com:13111 (with or without https://)
UNIPILE_DSN=
# Unipile API key (X-API-KEY)
UNIPILE_API_KEY=
# Shared secret sent by Unipile in the `Unipile-Auth` header of every webhook; generate: openssl rand -hex 32
# Used by outreach-unipile-webhook to authenticate inbound events and by outreach-unipile-setup when registering.
UNIPILE_WEBHOOK_SECRET=

# --- Platform internals (required) ---
# Shared secret between pg_cron (Vault secret `outreach_cron_secret`) and the workers (x-cron-secret header).
# MUST match the OUTREACH_CRON_SECRET passed to scripts/outreach-apply-migrations.sh. Generate: openssl rand -hex 32
OUTREACH_CRON_SECRET=
# AES-256-GCM key for LinkedIn cookie secrets: 32 random bytes, base64. Generate: openssl rand -base64 32
# Rotating it makes previously stored cookies undecryptable (see docs/outreach/SETUP.md → runbooks).
OUTREACH_COOKIE_KEY=
# Public origin of the web app (CORS is *, this is used for redirect / email links). Default https://app.capitalxai.com
OUTREACH_WEB_ORIGIN=https://app.capitalxai.com
# Base URL of the edge functions, with trailing slash. Default: <SUPABASE_URL>/functions/v1/ — leave empty unless proxied.
OUTREACH_FUNCTIONS_BASE_URL=

# --- AI (Google Gemini; same key the rest of the app uses. Without it classify returns `unclear`,
#     sequence QA runs static checks only, and AI drafts are unavailable) ---
GEMINI_API_KEY=
# Model id for classify / draft / sequence QA. Default gemini-3-flash-preview (falls back to GEMINI_MODEL_ID)
OUTREACH_AI_MODEL=gemini-3-flash-preview

# --- Stripe (optional until billing goes live) ---
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<ref>.supabase.co/functions/v1/outreach-stripe-webhook
STRIPE_WEBHOOK_SECRET=
# Recurring per-sender price ids (price_...). planFromSub() also matches on lookup_key / nickname containing
# "agency_plus" / "agency"; the mailbox add-on item is matched on lookup_key / nickname containing "mailbox".
STRIPE_PRICE_TEAM_SENDER=
STRIPE_PRICE_AGENCY_SENDER=
STRIPE_PRICE_AGENCY_PLUS_SENDER=
STRIPE_PRICE_MAILBOX_ADDON=

# --- Email via Resend (optional; without it notifications are logged and skipped) ---
RESEND_API_KEY=
# From header (domain must be verified in Resend). Default: CapitalxAI Outreach <no-reply@capitalxai.com>
OUTREACH_EMAIL_FROM=CapitalxAI Outreach <no-reply@capitalxai.com>
