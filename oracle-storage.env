# Oracle Object Storage — S3-compatible config for kaptured
# Tenancy: namankasliwal  |  Compartment: namankasliwal (root)
# Created: 20 Sep 2026
#
# Oracle exposes an S3-compatible API, so the standard AWS SDK works
# as long as you point it at S3_ENDPOINT and use path-style addressing.

S3_ENDPOINT=https://bmnn5bpwmyri.compat.objectstorage.ap-mumbai-1.oci.customer-oci.com
S3_REGION=ap-mumbai-1
S3_BUCKET=kaptured-storage
S3_NAMESPACE=bmnn5bpwmyri
S3_FORCE_PATH_STYLE=true

# Customer secret key "kaptured-s3" (Profile -> My profile -> Tokens and keys)
AWS_ACCESS_KEY_ID=PASTE_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=PASTE_SECRET_KEY_HERE
